# 本地临时文件
*.log
*.tmp
*.zip
*.msi
.DS_Store
Thumbs.db

# 本地校验脚手架（actionlint 对照实验 / 假 SMTP 端到端测试），不入库
.tmp-lint/

# 任何可能含密钥的本地文件
.env
*.secret
rclone.conf

# 智能体工作台：本地配置（含本机路径/凭据指向），不入库
workbench/config.json
# 智能体工作台：自动接力规则的运行状态（去重闩锁/历史，本机运行产物），不入库
workbench/_auto-start-state.json
workbench/_auto-start-state.json.tmp

# Python 缓存
__pycache__/
*.pyc
